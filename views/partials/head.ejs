<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Noto+Sans+SC:wght@400;700&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
<script>
(function () {
  var lang = 'en';
  try { lang = localStorage.getItem('wobazi-lang') || 'en'; } catch (e) {}
  lang = String(lang).toLowerCase();
  if (lang.indexOf('zh') === 0) lang = 'zh';
  else if (lang.indexOf('th') === 0) lang = 'th';
  else lang = 'en';
  document.documentElement.setAttribute('data-lang', lang);
  document.documentElement.lang = lang === 'zh' ? 'zh-CN' : lang;
})();
</script>
<link rel="stylesheet" href="/app/style.css?v=33">
<link rel="stylesheet" href="/public/css/public.css?v=11">
<style id="wobazi-i18n-css">
  html[data-lang="en"] .zh, html[data-lang="en"] .th { display: none !important; }
  html[data-lang="th"] .zh:has(~ .th), html[data-lang="th"] .zh.hide { display: none !important; }
  html[data-lang="th"] .en:has(~ .th) { display: none !important; }
  html[data-lang="th"] .th { display: revert !important; }
  html[data-lang="zh"] .th { display: none !important; }
  html[data-lang="zh"] .en:has(~ .zh) { display: none !important; }
  html[data-lang="zh"] .zh { display: revert !important; }
</style>
<script src="/public/js/i18n.js?v=6"></script>
